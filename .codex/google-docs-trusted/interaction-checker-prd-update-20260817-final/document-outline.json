      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "7. Open Questions",
      "protectedControls": []
    },
    {
      "paragraphId": "P00062",
      "path": "tabs.t.0.body.content[62]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4797,
      "endIndex": 5072,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "1. Question / decision needed: Confirm the approved narrow-viewport presentation for the sidebar and provide the final design reference. This is needed to complete visual acceptance for supported narrow viewports. Owner: PM / Design. Blocking: Yes — before final acceptance.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00063",
      "path": "tabs.t.0.body.content[63]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
