      "nestingLevel": null,
      "table": null,
      "text": "6. Success Metrics",
      "protectedControls": []
    },
    {
      "paragraphId": "P00057",
      "path": "tabs.t.0.body.content[57]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4273,
      "endIndex": 4511,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Leading release-quality measures: Verify, before release, that the action opens the sidebar; the sidebar can be closed; the original monograph context is retained; and the path works with keyboard navigation and supported viewport sizes.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00058",
      "path": "tabs.t.0.body.content[58]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
