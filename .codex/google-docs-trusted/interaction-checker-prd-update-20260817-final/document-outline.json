      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "R3 — Safe availability states",
      "protectedControls": []
    },
    {
      "paragraphId": "P00046",
      "path": "tabs.t.0.body.content[46]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3624,
      "endIndex": 3802,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "☐ While the checker is opening or loading, the sidebar provides an understandable in-progress state. The clinician can dismiss the sidebar and return to the unchanged monograph.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00047",
      "path": "tabs.t.0.body.content[47]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
