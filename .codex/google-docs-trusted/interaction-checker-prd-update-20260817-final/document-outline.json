      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "☐ If the checker cannot be loaded, the sidebar displays its standard unavailable state and can be dismissed so the clinician can continue using the monograph.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00048",
      "path": "tabs.t.0.body.content[48]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
