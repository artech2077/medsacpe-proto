      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "☐ This integration does not change the existing checker behavior for empty medication lists, no interactions found, or interaction results.",
      "protectedControls": []
    },
