      "protectedControls": []
    },
    {
      "paragraphId": "P00059",
      "path": "tabs.t.0.body.content[59]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4512,
      "endIndex": 4778,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Lagging user outcomes: Measure use of Check interactions and successful openings of the checker from the Interactions accordion. PM must approve the baseline, target, measurement period, and definition of a successful opening before launch measurement is evaluated.",
      "protectedControls": []
    },
    {
