      "path": "tabs.t.0.body.content[75]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5972,
      "endIndex": 6044,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "No production date is committed while the feature remains Pending lock.",
      "protectedControls": []
