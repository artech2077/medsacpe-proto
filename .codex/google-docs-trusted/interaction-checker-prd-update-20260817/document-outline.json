      "text": "6. Success Metrics",
      "protectedControls": []
    },
    {
      "paragraphId": "P00054",
      "path": "tabs.t.0.body.content[54]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3748,
