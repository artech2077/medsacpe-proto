      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Leading release-quality measures: Verify, before release, that the action opens the sidebar; the sidebar can be closed; the original monograph context is retained; and the path works with keyboard navigation and supported viewport sizes.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00055",
      "path": "tabs.t.0.body.content[55]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
